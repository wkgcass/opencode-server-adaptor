{
  "name": "opencode-server-adaptor",
  "version": "0.1.0",
  "description": "Generic Agent Server adapter implementing OpenCode Server compatibility (CLI, HTTP REST API, SSE) with pluggable Agent Adapters",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-server-adaptor": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "bun run node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bun-pty": "0.4.8",
    "hono": "4.10.7",
    "yaml": "^2.9.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.7",
    "@types/bun": "1.3.13",
    "prettier": "3.6.2",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
